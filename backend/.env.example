PORT=5003
# Set to 1 only when running behind a proxy locally. Production/Render enable
# trust proxy automatically (required by express-rate-limit on Render).
# TRUST_PROXY=1
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_application_key
JOOBLE_API_KEY=your_jooble_key

# Cover letter generation (Google Gemini). Keep this server-side only.
GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional sources. 
USAJOBS_API_KEY=your_usajobs_key
USAJOBS_EMAIL=you@example.com

FINDWORK_API_KEY=your_findwork_key
